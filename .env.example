# Public client config (safe to ship in the Flutter app)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Optional Groq API key for on-demand AI Engineering Analysis (workspace)
GROQ_API_KEY=your_groq_api_key

# Optional admin-only file for integration tests / ops (DO NOT put in pubspec assets)
# Copy to .env.admin locally:
# SERVICE_ROLE_SECRET=your_service_role_key
# SUPABASE_PERSONAL_ACCESS_TOKEN=your_management_api_token
